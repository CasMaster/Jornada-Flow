APP_NAME="Híbrido | Mix Fiscal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8081
ASSET_URL=http://localhost:8081
APP_TIMEZONE=America/Sao_Paulo
APP_ROUTE_PREFIX=
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR

APP_PORT=8081
APP_CONTAINER_NAME=hibrido-home-office-laravel
POSTGRES_CONTAINER_NAME=hibrido-home-office-postgres

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=hibrido
DB_USERNAME=hibrido
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
CACHE_STORE=database
QUEUE_CONNECTION=database

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Usado somente durante uma migração histórica de Laravel/SQLite.
LEGACY_SQLITE_PATH=/var/www/html/legacy/database.sqlite
