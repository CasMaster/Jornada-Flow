APP_NAME="Jornada Flow"
BRAND_NAME="Jornada Flow"
BRAND_COMPANY="[nome da organização]"
BRAND_INITIALS=JF
BRAND_TAGLINE="Controle simples. Trabalho flexível."
BRAND_DESCRIPTION="Solicitações e acompanhamento de home office e férias."
BRAND_THEME_COLOR="#071424"
BRAND_ACCENT_COLOR="#147b34"
BRAND_LOGO=assets/jornada-flow-logo.png
BRAND_LOGIN_LOGO=assets/jornada-flow-logo.png
BRAND_MARK=assets/jornada-flow-mark.png
BRAND_FAVICON=assets/jornada-flow-favicon.png
BRAND_FAVICON_MIME=image/png
BRAND_ICON_192=assets/icons/jornada-flow-192.png
BRAND_ICON_512=assets/icons/jornada-flow-512.png
BRAND_MASKABLE_ICON_512=assets/icons/jornada-flow-maskable-512.png
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8081
ASSET_URL=http://localhost:8081
APP_TIMEZONE=America/Sao_Paulo
APP_ROUTE_PREFIX=

# Autenticação corporativa Keycloak / OpenID Connect
OIDC_ENABLED=false
# Caminho no host; o deploy carrega este arquivo protegido antes de iniciar os containers.
OIDC_ENV_FILE=/home/admin/.config/mixhome-web/oidc.env
OIDC_ISSUER=https://auth.mixhome.app.br/realms/mixapps
OIDC_CLIENT_ID=mixhome-web
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://mixhome.app.br/auth/callback
OIDC_LOGOUT_REDIRECT_URI=https://mixhome.app.br
OIDC_SCOPES="openid profile email"
OIDC_SIGNING_ALGORITHM=RS256
OIDC_DISCOVERY_CACHE_SECONDS=3600
OIDC_JWKS_CACHE_SECONDS=3600
# Cliente de serviço separado, usado somente pelo comando de migração.
KEYCLOAK_MIGRATION_CLIENT_ID=
KEYCLOAK_MIGRATION_CLIENT_SECRET=
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR

APP_PORT=8081
APP_BIND_IP=127.0.0.1
APP_CONTAINER_NAME=hibrido-home-office-laravel
POSTGRES_CONTAINER_NAME=hibrido-home-office-postgres

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=hibrido
DB_USERNAME=hibrido
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_COOKIE=hibrido-mix-fiscal-session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=database
PASSWORD_RECOVERY_ENABLED=false

HOLIDAYS_API_URL=https://feriadosapi.com
HOLIDAYS_API_TOKEN=
HOLIDAYS_STATE=SP

LOG_CHANNEL=stack
LOG_LEVEL=debug
SLOW_REQUEST_MS=750
SLOW_QUERY_MS=250
DATA_RETENTION_ENABLED=false
DEPLOY_APPROVAL_ENV=
DEPLOY_APPROVAL_KEY=
DEPLOY_PENDING_HOST_DIR=./storage/deploy-pending
DEPLOY_APPROVED_HOST_DIR=./storage/deploy-approved
MAIL_NOTIFICATIONS_ENABLED=false
AUTOMATED_NOTIFICATION_EXCLUDED_EMAILS=gestor@mixfiscal.com.br

MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hibrido@localhost
MAIL_FROM_NAME="Jornada Flow"

# Usado somente durante uma migração histórica de Laravel/SQLite.
LEGACY_SQLITE_PATH=/var/www/html/legacy/database.sqlite
