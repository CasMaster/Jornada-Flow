APP_NAME="MixHome | Mix Fiscal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8081
ASSET_URL=http://localhost:8081
APP_TIMEZONE=America/Sao_Paulo
APP_ROUTE_PREFIX=
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR

APP_PORT=8081
APP_BIND_IP=127.0.0.1
APP_CONTAINER_NAME=hibrido-home-office-laravel
POSTGRES_CONTAINER_NAME=hibrido-home-office-postgres

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=hibrido
DB_USERNAME=hibrido
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_COOKIE=hibrido-mix-fiscal-session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=database
PASSWORD_RECOVERY_ENABLED=false

HOLIDAYS_API_URL=https://feriadosapi.com
HOLIDAYS_API_TOKEN=
HOLIDAYS_STATE=SP

LOG_CHANNEL=stack
LOG_LEVEL=debug
SLOW_REQUEST_MS=750
SLOW_QUERY_MS=250
DATA_RETENTION_ENABLED=false
MAIL_NOTIFICATIONS_ENABLED=false

MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hibrido@localhost
MAIL_FROM_NAME="MixHome | Mix Fiscal"

# Usado somente durante uma migração histórica de Laravel/SQLite.
LEGACY_SQLITE_PATH=/var/www/html/legacy/database.sqlite
